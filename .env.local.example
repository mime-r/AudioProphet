# Copy this file to .env.local and fill in your secrets.
ADMIN_USER=admin
ADMIN_PASS=password
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=audio-prophet
# Secret token that allows the scraper-agent to bypass reCAPTCHA. Must match SCRAPER_API_KEY in scraper-agent/.env
SCRAPER_API_KEY=your_scraper_secret_here

