{
  "name": "audio-prophet-scraper-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered scraper agent for Audio Prophet - automatically discovers upcoming audiophile products from Twitter/X and Head-Fi forums",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "web": "node dist/server.js",
    "dev": "tsx src/index.ts",
    "dev:web": "tsx watch src/server.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^7.2.0",
    "openai": "^4.86.2",
    "playwright": "^1.52.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
