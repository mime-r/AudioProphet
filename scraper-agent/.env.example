# === AI Provider (pick one) ===
# OpenAI
OPENAI_API_KEY=sk-...
# OR Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Or LM Studio (local inference - zero cost)
AI_PROVIDER=lmstudio
# AI model (optional, defaults: gpt-4o / claude-3-opus-20240229 / phi-3-mini for local)
AI_MODEL=microsoft/phi-3-mini-128k-instruct
# LM Studio base URL (only needed if not using default localhost:1234/v1)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# === MongoDB (for dedup check) ===
MONGODB_URI=mongodb+srv://user:pass@cluster/audio-prophet
MONGODB_DB=audio-prophet

# === Main App URL (where submissions will be sent) ===
APP_URL=http://localhost:3000

# === Twitter/X (optional - only if you want to scrape Twitter) ===
# Method: "api" (requires paid API) or "browser" (uses Playwright + cookies)
TWITTER_SCRAPE_METHOD=browser
# For browser method: path to cookies JSON file (exported from browser)
TWITTER_COOKIES_PATH=./config/twitter_cookies.json
# For API method:
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# === Server (for the review web UI) ===
PORT=4000
